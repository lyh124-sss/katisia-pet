{
  "name": "katisia-pet",
  "version": "1.0.0",
  "private": true,
  "description": "卡提希娅桌宠",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "build": {
    "appId": "com.yourname.katisiapet",
    "productName": "KatisiaPet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
